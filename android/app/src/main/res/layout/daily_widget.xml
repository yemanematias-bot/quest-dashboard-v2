<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
<TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DAILY QUESTS" android:textSize="18sp" android:textStyle="bold" android:textColor="#67E8CB"/>
<TextView android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:paddingBottom="8dp" android:textColor="#A7B9BA"/>
<TextView android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textColor="#F3F7FA"/>
<TextView android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textColor="#F3F7FA"/>
<TextView android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textColor="#F3F7FA"/>
<TextView android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textColor="#F3F7FA"/>
<TextView android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textColor="#F3F7FA"/>
<TextView android:id="@+id/footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:paddingTop="8dp" android:textColor="#A7B9BA"/>
</LinearLayout>